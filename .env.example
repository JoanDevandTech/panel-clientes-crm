# API base URL del CRM. Apunta a tu backend Laravel (api.kromagency.es / crm.kromagency.es).
# El path /api/v1 es el mismo que usa el portal de Noval.
VITE_API_URL=https://crm.kromagency.es/api/v1

# Marca mostrada en el sidebar y como emisor en facturas/presupuestos.
VITE_BRAND_NAME=Krom
VITE_BRAND_INITIALS=KR
VITE_BRAND_SUBTITLE=Portal cliente

# Datos del emisor mostrados en el detalle de factura/presupuesto.
VITE_BRAND_ADDRESS_LINE_1=
VITE_BRAND_ADDRESS_LINE_2=

# (Opcional) Clave pública de reCAPTCHA v3. Si se deja vacío, el envío de tickets
# funciona sin reCAPTCHA.
VITE_RECAPTCHA_SITE_KEY=
